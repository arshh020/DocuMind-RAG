# Fetched third-party corpora. scripts/fetch_corpus.py writes MDN pages as flat
# files directly into data/corpus/, flattening their site path with "__"
# (e.g. guides__caching__index.md). That content belongs to MDN's own project
# under its own license (CC-BY-SA) and must not be committed into this
# portfolio repo. Only the hand-written seed docs below are committed so the
# smoke test works on a fresh clone.
data/corpus/*
!data/corpus/LICENSE.txt
!data/corpus/css-flexbox.md
!data/corpus/http-caching.md
!data/corpus/js-promises.md

# Build outputs. Regenerated by `make index` in seconds/minutes.
# Exception: the prebuilt search index is committed on purpose so the
# deployed demo has a working index without depending on a live corpus
# rebuild at deploy time. Contains MDN (CC-BY-SA) derived chunks; see
# README for attribution.
artifacts/*
!artifacts/index/

# Secrets
.env
.env.local

# NOTE: eval/evalset.jsonl is intentionally NOT ignored. The gold labels are
# the most valuable artifact in this repo and the only reason the results
# table means anything. Commit them.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
