# Copy to .env and fill in what you need. Nothing here is required for
# retrieval-only work: `--provider hash` plus `scripts/ask.py --retrieval-only`
# runs the whole retrieval stack and the full eval sweep with no keys at all.

# ---------------------------------------------------------------- generation
# Free tier, fast, OpenAI-compatible. https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Temperature 0 is deliberate. This is extractive QA over retrieved context;
# sampling creativity here only buys you hallucinations.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60.0

# ---------------------------------------------------------------- embeddings
# sentence-transformers (local, free, needs torch) | openai | hash (offline stub)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
# Only needed when EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1

# ----------------------------------------------------------------- retrieval
# candidate_k is the pool each retriever returns before fusion/reranking;
# top_k is what reaches the LLM. candidate_k must exceed top_k or reranking
# has nothing to reorder.
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=5
# dense | bm25 | hybrid
RETRIEVAL_MODE=hybrid
# rrf | normalized
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=1.0
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_MIN_SCORE=0.0

# ------------------------------------------------------------------ reranking
# Off by default: turn it on only if your own eval sweep shows it earns its
# latency. cross-encoder needs the [local] extra; llm needs only GROQ_API_KEY.
RERANK_ENABLED=false
RERANK_PROVIDER=cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
RERANK_BATCH_SIZE=32

# ---------------------------------------------------------------- chunking
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=16

# -------------------------------------------------------------------- paths
CORPUS_DIR=data/corpus
INDEX_DIR=artifacts/index
EVAL_DIR=eval
RESULTS_DIR=artifacts/results

# ---------------------------------------------------------------- serving
PORT=8000
# Lock this down to your UI's origin before you call it deployed.
CORS_ORIGINS=*
